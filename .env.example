# Global configuration for vuln-labs
# Host binding: 127.0.0.1 for local, or 0.0.0.0 if hosting on VPS
HOST_BIND_IP=127.0.0.1

# Unified port for the active running lab
PORT=8081

# Unified mode for the active running lab ('vulnerable' or 'secure')
MODE=vulnerable

# Secret Key
SECRET_KEY=lab_secret_key_change_in_production_123456
