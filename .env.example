# Global configuration for vuln-labs
# Copy to .env and adjust as needed

# Host binding: 127.0.0.1 for local only, or 0.0.0.0 if hosting on VPS
HOST_BIND_IP=127.0.0.1

# Default port for Lab 01 (Web Cache Deception)
WCD_PORT=8081

# Lab Mode: 'vulnerable' or 'secure'
WCD_MODE=vulnerable

# Secret key for session management
SECRET_KEY=lab_secret_key_change_in_production_123456
