<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NovaCorp Cloud Vault - Lab 05 (Ruby on Rails)</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="bg-light">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <span class="text-info">Nova</span>Corp Cloud Vault
      </a>
      <div class="d-flex align-items-center">
        <% if lab_mode == "vulnerable" %>
          <span class="badge bg-danger me-3 px-3 py-2">MODE: VULNERABLE</span>
        <% else %>
          <span class="badge bg-success me-3 px-3 py-2">MODE: SECURE</span>
        <% end %>
      </div>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/profile">Infrastructure Vault</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/report">Audit Bot (Report Link)</a>
          </li>
          <% if current_username %>
            <li class="nav-item dropdown ms-2">
              <span class="navbar-text text-light me-2">👤 <%= current_username %></span>
              <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
            </li>
          <% else %>
            <li class="nav-item ms-2">
              <a class="btn btn-info btn-sm fw-bold text-dark" href="/login">Sign In</a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <% if @alert_message %>
      <div class="alert alert-<%= @alert_type || 'info' %> alert-dismissible fade show" role="alert">
        <%= @alert_message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <%= yield %>
  </div>

  <footer class="text-center text-muted py-4 border-top mt-5">
    <div class="container">
      <small>Web Cache Deception Lab 05 (Ruby on Rails Dot-Format Delimiter + Cloudflare) &bull; Designed for offensive &amp; defensive security practice</small>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
